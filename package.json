{
  "name": "dsh-mneme-moe4all",
  "description": "MoE4All edition of the Mneme cross-session memory plugin for DeepSeek Harness",
  "version": "0.7.29-moe4all.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Headmaster218/dsh-mneme-moe4all.git"
  },
  "homepage": "https://github.com/Headmaster218/dsh-mneme-moe4all#readme",
  "bugs": {
    "url": "https://github.com/Headmaster218/dsh-mneme-moe4all/issues"
  },
  "moe4all": {
    "upstream": "@modusensus/dsh-mneme@0.7.29",
    "repository": "https://github.com/modusensus/dsh-mneme",
    "commit": "0b3e99f6ff4948ab4b823914a0a16f4411d25a4c"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-mneme": "bin/cli.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "scripts",
    "test",
    "cordis.patch.yml"
  ],
  "dsh": {
    "client": {
      "inject": [
        "slots",
        "locale"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-better-sidebar": "^0.18.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "c8": "^12.0.0",
    "lucide": "^1.42.0"
  },
  "scripts": {
    "sync": "node scripts/sync-lib.js",
    "prepack": "npm run sync",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 node --test test/*.test.js",
    "e2e": "node scripts/e2e-dsh.js",
    "stress": "node scripts/stress-dsh.js",
    "ci:check": "node --experimental-vm-modules ci/plugin-ci.mjs check",
    "ci:test": "node ci/plugin-ci.mjs test",
    "ci:contract": "node ci/plugin-ci.mjs test-contract",
    "release:build": "node --experimental-vm-modules ci/plugin-ci.mjs pack",
    "release:verify": "node ci/plugin-ci.mjs verify-release"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ],
    "exclude": [
      "lib/**",
      "test/**",
      "**/*.test.js"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "morphicons": "^1.7.1"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.24.3": true,
    "sharp@0.34.5": true
  },
  "packageManager": "npm@10.9.2"
}
